# Copy this file to ".env" and fill in real values.
# ".env" is ignored by Git, so your real key stays on your machine.

# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your-api-key-here

# Claude model name. Kept here (not in code) so it can change without a code edit.
CLAUDE_MODEL=your-model-name-here

# Frontend URLs allowed to call the API (comma-separated).
# Local Vite dev server by default; add the Vercel URL in production.
CORS_ORIGINS=http://localhost:5173

# Database for saved assessments. Optional locally.
# Default: sqlite:///./sustainiq.db (a file in the backend/ folder)
# Production: the PostgreSQL URL from Neon, e.g.
#   postgresql://user:password@ep-xyz.eu-central-1.aws.neon.tech/sustainiq?sslmode=require
DATABASE_URL=sqlite:///./sustainiq.db
